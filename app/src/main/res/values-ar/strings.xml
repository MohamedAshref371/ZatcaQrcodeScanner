    <string name="app_name">قارئ فاتورة</string>
    <string name="app_description">قراءة رموز QR للفواتير الإلكترونية السعودية وعرض بياناتها وحفظ سجلها محليًا.</string>
    <string name="about_app">حول التطبيق</string>
